{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"required": ["protocol", "version", "routeId", "envelope"],
	"properties": {
		"protocol": {
			"type": "string",
			"const": "yonder.execution.relay"
		},
		"version": {
			"type": "number",
			"const": 1
		},
		"routeId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 4096
		},
		"envelope": {
			"type": "object",
			"required": ["algorithm", "keyId", "payloadBase64", "signatureBase64"],
			"properties": {
				"algorithm": {
					"type": "string",
					"const": "Ed25519"
				},
				"keyId": {
					"type": "string",
					"pattern": "^[a-f0-9]{64}$"
				},
				"payloadBase64": {
					"type": "string",
					"minLength": 4,
					"maxLength": 1398104,
					"pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
				},
				"signatureBase64": {
					"type": "string",
					"minLength": 88,
					"maxLength": 88,
					"pattern": "^[A-Za-z0-9+/]{86}==$"
				}
			},
			"additionalProperties": false
		}
	},
	"additionalProperties": false
}
