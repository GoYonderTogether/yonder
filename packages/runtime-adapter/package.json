{
	"name": "@yonder/runtime-adapter",
	"version": "0.3.26110214",
	"type": "module",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=22.19"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./contracts": {
			"types": "./dist/contracts.d.ts",
			"import": "./dist/contracts.js"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"import": "./dist/types.js"
		},
		"./node": {
			"types": "./dist/node/index.d.ts",
			"import": "./dist/node/index.js"
		},
		"./postgres": {
			"types": "./dist/postgres/index.d.ts",
			"import": "./dist/postgres/index.js"
		},
		"./*.js": {
			"types": "./dist/*.d.ts",
			"import": "./dist/*.js"
		},
		"./*": {
			"types": "./dist/*.d.ts",
			"import": "./dist/*.js"
		}
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"@earendil-works/chord": "1.3.0",
		"@earendil-works/pi-ai": "1.3.0",
		"@earendil-works/pi-durable": "1.3.0",
		"@yonder/bot-definition": "0.3.26110214",
		"@yonder/sdk": "0.3.26110214",
		"@yonder/protocol": "0.3.26110214",
		"pg": "8.23.1",
		"proper-lockfile": "4.1.2",
		"typebox": "1.3.27",
		"yaml": "2.9.1"
	},
	"devDependencies": {
		"@types/pg": "8.23.1",
		"@types/proper-lockfile": "4.1.4"
	}
}
