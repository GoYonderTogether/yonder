{
	"identifier": "mobile",
	"windows": ["main"],
	"platforms": ["android", "iOS"],
	"remote": { "urls": ["https://demo.zethai.cn/*", "https://yonderbot.net/*"] },
	"permissions": [
		"core:default",
		"yonder-device:allow-status",
		"yonder-device:allow-request",
		"yonder-device:allow-calendar-events",
		"yonder-device:allow-reminders",
		"yonder-device:allow-contacts",
		"yonder-device:allow-photos-status",
		"yonder-device:allow-location",
		"yonder-device:allow-health"
	]
}
