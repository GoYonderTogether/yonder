# Copy to deploy/node/local.env (gitignored) and fill in private values.
# scripts/deploy-node.sh sources this file if it exists.
#
# Server to deploy to (used when <host> is not given on the command line):
YONDER_DEPLOY_HOST=
# Public origin served by nginx (required for `nginx` commands), e.g. https://console.example.com:
YONDER_PUBLIC_ORIGIN=
# Optional: explicit path to a local auth.json holding the rightapi-glm key
# (default search paths are documented in scripts/deploy-node.sh):
YONDER_GLM_KEY_FILE=
# Optional: gateway health-check port for `rollback` (default 8787):
YONDER_HEALTH_PORT=
