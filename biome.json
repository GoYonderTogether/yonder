{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"files": {
		"includes": [
			"**",
			"!**/dist",
			"!**/.build",
			"!**/.cache",
			"!.pi/tasks",
			"!.vitest/json",
			"!apps/desktop/src-tauri/gen",
			"!apps/desktop/src-tauri/runtime",
			"!apps/desktop/src-tauri/target",
			"!**/node_modules",
			"!**/.yonder",
			"!bp",
			"!.claude",
			"!packages/pi-durable"
		]
	},
	"formatter": {
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"overrides": [
		{
			"includes": ["apps/app/**/*.css"],
			"css": { "parser": { "tailwindDirectives": true } },
			"linter": { "rules": { "style": { "noDescendingSpecificity": "off" } } }
		},
		{
			"includes": ["plugins/tasks/src/prompts.ts"],
			"formatter": {
				"enabled": false
			}
		}
	]
}
