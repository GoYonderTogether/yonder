{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"files": {
		"includes": [
			"**",
			"!**/dist",
			"!**/.build",
			"!**/node_modules",
			"!**/.yonder",
			"!bp",
			"!.claude",
			"!packages/pi-durable"
		]
	},
	"formatter": {
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"overrides": [
		{
			"includes": ["plugins/tasks/src/prompts.ts"],
			"formatter": {
				"enabled": false
			}
		}
	]
}
