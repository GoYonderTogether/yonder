{
	"name": "@yonder/plugin-native-automation",
	"version": "0.3.26103012",
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=22.19"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"NOTICE.md"
	],
	"dependencies": {
		"@yonder/sdk": "0.3.26103012",
		"playwright-core": "1.64.1",
		"typebox": "1.3.27"
	},
	"yonder": {
		"apiVersion": 1,
		"id": "native-automation",
		"entry": "./dist/index.js",
		"contributes": {
			"permissions": [
				"native-automation"
			],
			"tools": [
				"native-automation_browser",
				"native-automation_desktop"
			],
			"triggers": [
				"native-automation-cleanup"
			]
		}
	}
}
