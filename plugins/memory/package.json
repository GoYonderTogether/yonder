{
	"name": "@yonder/plugin-memory",
	"version": "0.3.26103001",
	"type": "module",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=22.19"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"dependencies": {
		"@yonder/sdk": "0.3.26103001",
		"typebox": "1.3.27",
		"yaml": "2.9.1",
		"luxon": "3.7.2",
		"write-file-atomic": "6.0.0",
		"chokidar": "5.0.0",
		"proper-lockfile": "4.1.2",
		"gpt-tokenizer": "4.1.0"
	},
	"yonder": {
		"apiVersion": 1,
		"id": "memory",
		"entry": "./dist/index.js",
		"contributes": {
			"tools": [
				"memory_status",
				"memory_capture",
				"memory_search",
				"memory_read",
				"memory_plan",
				"memory_review",
				"memory_me",
				"memory_import",
				"memory_bootstrap"
			],
			"triggers": [
				"memory-bootstrap",
				"memory-inbox"
			],
			"presets": [
				"memory-keeper"
			],
			"contexts": [
				"memory-core",
				"memory-week"
			],
			"skills": [
				"memory-evening-wrap",
				"memory-monthly-plan",
				"memory-morning-brief",
				"memory-onboard-legacy",
				"memory-onboarding",
				"memory-weekly-review"
			]
		}
	},
	"devDependencies": {
		"@types/luxon": "3.7.6",
		"@types/write-file-atomic": "4.0.3",
		"@types/proper-lockfile": "4.1.4"
	}
