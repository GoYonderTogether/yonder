{
	"name": "@yonder/plugin-wechat-archive",
	"version": "0.2.26102404",
	"type": "module",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=22.19"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"NOTICE.md"
	],
	"dependencies": {
		"@yonder/sdk": "0.2.26102404",
		"typebox": "1.3.27"
	},
	"yonder": {
		"apiVersion": 1,
		"id": "wechat-archive",
		"entry": "./dist/index.js",
		"contributes": {
			"tools": [
				"wechat-archive_status",
				"wechat-archive_sources",
				"wechat-archive_history",
				"wechat-archive_search",
				"wechat-archive_message",
				"wechat-archive_media",
				"wechat-archive_policy"
			],
			"triggers": [
				"wechat-archive"
			]
		}
	}
}
