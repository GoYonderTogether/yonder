{
	"name": "@yonder/plugin-code-intel",
	"version": "0.3.26102909",
	"type": "module",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=22.19"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"NOTICE"
	],
	"dependencies": {
		"@yonder/sdk": "0.3.26102909",
		"typebox": "1.3.27"
	},
	"yonder": {
		"apiVersion": 1,
		"id": "code-intel",
		"entry": "./dist/index.js",
		"contributes": {
			"triggers": [
				"code-intel-cleanup"
			],
			"tools": [
				"code-intel_codegraph_explore",
				"code-intel_module_report",
				"code-intel_project_report",
				"code-intel_ast_grep_replace",
				"code-intel_ast_grep_outline",
				"code-intel_ast_grep_search",
				"code-intel_read_enclosing",
				"code-intel_read_symbol",
				"code-intel_symbol_search",
				"code-intel_effective_config",
				"code-intel_lsp_navigation",
				"code-intel_lens_diagnostic_mark",
				"code-intel_lens_diagnostics"
			]
		}
	}
}
