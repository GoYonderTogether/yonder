{
	"name": "@yonder/plugin-ui-companion",
	"version": "0.2.26102403",
	"type": "module",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=22.19"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist/*.js",
		"dist/*.d.ts",
		"dist/*.map",
		"dist/index.html",
		"web/state.mjs",
		"web/state.d.mts",
		"README.md",
		"web/assets/Geist-LICENSE"
	],
	"dependencies": {
		"@yonder/sdk": "0.2.26102403",
		"typebox": "1.3.27"
	},
	"yonder": {
		"apiVersion": 1,
		"id": "ui-companion",
		"entry": "./dist/index.js",
		"contributes": {
			"tools": [
				"ui-companion_present",
				"ui-companion_result"
			],
			"triggers": [
				"ui-companion-service"
			]
		}
	}
}
