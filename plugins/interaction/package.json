{
	"name": "@yonder/plugin-interaction",
	"version": "0.3.26103101",
	"type": "module",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=22.19"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist/*.js",
		"dist/*.d.ts",
		"dist/*.map",
		"state.mjs",
		"state.d.mts",
		"README.md"
	],
	"dependencies": {
		"@yonder/sdk": "0.3.26103101",
		"typebox": "1.3.27"
	},
	"yonder": {
		"apiVersion": 1,
		"id": "interaction",
		"entry": "./dist/index.js",
		"contributes": {
			"views": [
				"interaction.card"
			],
			"tools": [
				"interaction_present",
				"interaction_result"
			],
			"triggers": [
				"interaction-service"
			]
		}
	}
}
