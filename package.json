		"plugins/market"
	],
	"scripts": {
		"version:check": "node scripts/version-check.mjs --check",
		"ci:remote": "node scripts/ci-remote.mjs",
		"test:changed": "node scripts/test-changed.mjs",
		"release:pack": "node scripts/release/pack-runtime.mjs",
		"build": "node scripts/check-pi-ai-bundle.mjs && node scripts/build-tsc.mjs && node scripts/check-dist-sync.mjs && node plugins/devices/build.mjs && node scripts/build-macos.mjs && npm run build:app",
		"build:app": "npm run build -w @yonder/app",
		"typecheck": "tsc -b --force",
		"build:clean": "rm -rf packages/*/dist plugins/*/dist apps/app/dist && npm run build",
		"check:dist": "node scripts/check-dist-sync.mjs",
		"test": "vitest run --exclude '**/dist/**'",
		"test:node": "node --test apps/desktop/src-tauri/src/activity.test.cjs scripts/export-model-observations.test.mjs scripts/migrate/rename-yonder.test.mjs scripts/test/names-consistency.test.mjs packages/macos/test/install-root.test.mjs scripts/release/ci-status.test.mjs scripts/release/changelog.test.mjs scripts/release/version.test.mjs scripts/release/bump-versions.test.mjs scripts/release/pack-runtime.test.mjs",
		"lint:size": "node scripts/check-file-size.mjs",
		"lint": "biome check . && node scripts/check-file-size.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/node": "22.20.5",
		"typescript": "7.0.2",
		"vitest": "5.0.5"
	},
	"repository": "https://github.com/GoYonderTogether/yonder",
	"version": "0.3.26103015",
	"overrides": {
		"@earendil-works/pi-ai": "$@earendil-works/pi-ai",
		"body-parser": "2.4.0",
		"fast-uri": "3.1.9",
		"undici": "8.12.2"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "file:./third_party/pi-ai/pi-ai-5414b87ae1909d708d4e188ba582d12486ebb0c5-b4c444bf31f5.tgz"
	}
}
