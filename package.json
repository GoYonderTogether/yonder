	"engines": {
		"node": ">=22.19"
	},
	"workspaces": [
		"packages/design",
		"packages/pi-durable",
		"packages/protocol",
		"packages/device",
		"packages/sdk",
		"packages/core",
		"packages/gateway",
		"packages/cli",
		"apps/app",
		"plugins/channel-cli",
		"plugins/context-files",
		"plugins/agent-presets",
		"plugins/channel-mcp",
		"plugins/codex-tools",
		"plugins/browser-skill",
		"plugins/web-tools",
		"plugins/channel-github",
		"plugins/channel-feishu",
		"plugins/media-tools",
		"plugins/cron",
		"plugins/mcp-client",
		"plugins/native-automation",
		"plugins/wechat-archive",
		"plugins/channel-wechat-ilink",
		"plugins/clipboard",
		"plugins/channel-qq",
		"plugins/social",
		"plugins/memory",
		"plugins/interaction",
		"plugins/channel-card",
		"plugins/devices",
		"plugins/learning",
		"plugins/secrets",
